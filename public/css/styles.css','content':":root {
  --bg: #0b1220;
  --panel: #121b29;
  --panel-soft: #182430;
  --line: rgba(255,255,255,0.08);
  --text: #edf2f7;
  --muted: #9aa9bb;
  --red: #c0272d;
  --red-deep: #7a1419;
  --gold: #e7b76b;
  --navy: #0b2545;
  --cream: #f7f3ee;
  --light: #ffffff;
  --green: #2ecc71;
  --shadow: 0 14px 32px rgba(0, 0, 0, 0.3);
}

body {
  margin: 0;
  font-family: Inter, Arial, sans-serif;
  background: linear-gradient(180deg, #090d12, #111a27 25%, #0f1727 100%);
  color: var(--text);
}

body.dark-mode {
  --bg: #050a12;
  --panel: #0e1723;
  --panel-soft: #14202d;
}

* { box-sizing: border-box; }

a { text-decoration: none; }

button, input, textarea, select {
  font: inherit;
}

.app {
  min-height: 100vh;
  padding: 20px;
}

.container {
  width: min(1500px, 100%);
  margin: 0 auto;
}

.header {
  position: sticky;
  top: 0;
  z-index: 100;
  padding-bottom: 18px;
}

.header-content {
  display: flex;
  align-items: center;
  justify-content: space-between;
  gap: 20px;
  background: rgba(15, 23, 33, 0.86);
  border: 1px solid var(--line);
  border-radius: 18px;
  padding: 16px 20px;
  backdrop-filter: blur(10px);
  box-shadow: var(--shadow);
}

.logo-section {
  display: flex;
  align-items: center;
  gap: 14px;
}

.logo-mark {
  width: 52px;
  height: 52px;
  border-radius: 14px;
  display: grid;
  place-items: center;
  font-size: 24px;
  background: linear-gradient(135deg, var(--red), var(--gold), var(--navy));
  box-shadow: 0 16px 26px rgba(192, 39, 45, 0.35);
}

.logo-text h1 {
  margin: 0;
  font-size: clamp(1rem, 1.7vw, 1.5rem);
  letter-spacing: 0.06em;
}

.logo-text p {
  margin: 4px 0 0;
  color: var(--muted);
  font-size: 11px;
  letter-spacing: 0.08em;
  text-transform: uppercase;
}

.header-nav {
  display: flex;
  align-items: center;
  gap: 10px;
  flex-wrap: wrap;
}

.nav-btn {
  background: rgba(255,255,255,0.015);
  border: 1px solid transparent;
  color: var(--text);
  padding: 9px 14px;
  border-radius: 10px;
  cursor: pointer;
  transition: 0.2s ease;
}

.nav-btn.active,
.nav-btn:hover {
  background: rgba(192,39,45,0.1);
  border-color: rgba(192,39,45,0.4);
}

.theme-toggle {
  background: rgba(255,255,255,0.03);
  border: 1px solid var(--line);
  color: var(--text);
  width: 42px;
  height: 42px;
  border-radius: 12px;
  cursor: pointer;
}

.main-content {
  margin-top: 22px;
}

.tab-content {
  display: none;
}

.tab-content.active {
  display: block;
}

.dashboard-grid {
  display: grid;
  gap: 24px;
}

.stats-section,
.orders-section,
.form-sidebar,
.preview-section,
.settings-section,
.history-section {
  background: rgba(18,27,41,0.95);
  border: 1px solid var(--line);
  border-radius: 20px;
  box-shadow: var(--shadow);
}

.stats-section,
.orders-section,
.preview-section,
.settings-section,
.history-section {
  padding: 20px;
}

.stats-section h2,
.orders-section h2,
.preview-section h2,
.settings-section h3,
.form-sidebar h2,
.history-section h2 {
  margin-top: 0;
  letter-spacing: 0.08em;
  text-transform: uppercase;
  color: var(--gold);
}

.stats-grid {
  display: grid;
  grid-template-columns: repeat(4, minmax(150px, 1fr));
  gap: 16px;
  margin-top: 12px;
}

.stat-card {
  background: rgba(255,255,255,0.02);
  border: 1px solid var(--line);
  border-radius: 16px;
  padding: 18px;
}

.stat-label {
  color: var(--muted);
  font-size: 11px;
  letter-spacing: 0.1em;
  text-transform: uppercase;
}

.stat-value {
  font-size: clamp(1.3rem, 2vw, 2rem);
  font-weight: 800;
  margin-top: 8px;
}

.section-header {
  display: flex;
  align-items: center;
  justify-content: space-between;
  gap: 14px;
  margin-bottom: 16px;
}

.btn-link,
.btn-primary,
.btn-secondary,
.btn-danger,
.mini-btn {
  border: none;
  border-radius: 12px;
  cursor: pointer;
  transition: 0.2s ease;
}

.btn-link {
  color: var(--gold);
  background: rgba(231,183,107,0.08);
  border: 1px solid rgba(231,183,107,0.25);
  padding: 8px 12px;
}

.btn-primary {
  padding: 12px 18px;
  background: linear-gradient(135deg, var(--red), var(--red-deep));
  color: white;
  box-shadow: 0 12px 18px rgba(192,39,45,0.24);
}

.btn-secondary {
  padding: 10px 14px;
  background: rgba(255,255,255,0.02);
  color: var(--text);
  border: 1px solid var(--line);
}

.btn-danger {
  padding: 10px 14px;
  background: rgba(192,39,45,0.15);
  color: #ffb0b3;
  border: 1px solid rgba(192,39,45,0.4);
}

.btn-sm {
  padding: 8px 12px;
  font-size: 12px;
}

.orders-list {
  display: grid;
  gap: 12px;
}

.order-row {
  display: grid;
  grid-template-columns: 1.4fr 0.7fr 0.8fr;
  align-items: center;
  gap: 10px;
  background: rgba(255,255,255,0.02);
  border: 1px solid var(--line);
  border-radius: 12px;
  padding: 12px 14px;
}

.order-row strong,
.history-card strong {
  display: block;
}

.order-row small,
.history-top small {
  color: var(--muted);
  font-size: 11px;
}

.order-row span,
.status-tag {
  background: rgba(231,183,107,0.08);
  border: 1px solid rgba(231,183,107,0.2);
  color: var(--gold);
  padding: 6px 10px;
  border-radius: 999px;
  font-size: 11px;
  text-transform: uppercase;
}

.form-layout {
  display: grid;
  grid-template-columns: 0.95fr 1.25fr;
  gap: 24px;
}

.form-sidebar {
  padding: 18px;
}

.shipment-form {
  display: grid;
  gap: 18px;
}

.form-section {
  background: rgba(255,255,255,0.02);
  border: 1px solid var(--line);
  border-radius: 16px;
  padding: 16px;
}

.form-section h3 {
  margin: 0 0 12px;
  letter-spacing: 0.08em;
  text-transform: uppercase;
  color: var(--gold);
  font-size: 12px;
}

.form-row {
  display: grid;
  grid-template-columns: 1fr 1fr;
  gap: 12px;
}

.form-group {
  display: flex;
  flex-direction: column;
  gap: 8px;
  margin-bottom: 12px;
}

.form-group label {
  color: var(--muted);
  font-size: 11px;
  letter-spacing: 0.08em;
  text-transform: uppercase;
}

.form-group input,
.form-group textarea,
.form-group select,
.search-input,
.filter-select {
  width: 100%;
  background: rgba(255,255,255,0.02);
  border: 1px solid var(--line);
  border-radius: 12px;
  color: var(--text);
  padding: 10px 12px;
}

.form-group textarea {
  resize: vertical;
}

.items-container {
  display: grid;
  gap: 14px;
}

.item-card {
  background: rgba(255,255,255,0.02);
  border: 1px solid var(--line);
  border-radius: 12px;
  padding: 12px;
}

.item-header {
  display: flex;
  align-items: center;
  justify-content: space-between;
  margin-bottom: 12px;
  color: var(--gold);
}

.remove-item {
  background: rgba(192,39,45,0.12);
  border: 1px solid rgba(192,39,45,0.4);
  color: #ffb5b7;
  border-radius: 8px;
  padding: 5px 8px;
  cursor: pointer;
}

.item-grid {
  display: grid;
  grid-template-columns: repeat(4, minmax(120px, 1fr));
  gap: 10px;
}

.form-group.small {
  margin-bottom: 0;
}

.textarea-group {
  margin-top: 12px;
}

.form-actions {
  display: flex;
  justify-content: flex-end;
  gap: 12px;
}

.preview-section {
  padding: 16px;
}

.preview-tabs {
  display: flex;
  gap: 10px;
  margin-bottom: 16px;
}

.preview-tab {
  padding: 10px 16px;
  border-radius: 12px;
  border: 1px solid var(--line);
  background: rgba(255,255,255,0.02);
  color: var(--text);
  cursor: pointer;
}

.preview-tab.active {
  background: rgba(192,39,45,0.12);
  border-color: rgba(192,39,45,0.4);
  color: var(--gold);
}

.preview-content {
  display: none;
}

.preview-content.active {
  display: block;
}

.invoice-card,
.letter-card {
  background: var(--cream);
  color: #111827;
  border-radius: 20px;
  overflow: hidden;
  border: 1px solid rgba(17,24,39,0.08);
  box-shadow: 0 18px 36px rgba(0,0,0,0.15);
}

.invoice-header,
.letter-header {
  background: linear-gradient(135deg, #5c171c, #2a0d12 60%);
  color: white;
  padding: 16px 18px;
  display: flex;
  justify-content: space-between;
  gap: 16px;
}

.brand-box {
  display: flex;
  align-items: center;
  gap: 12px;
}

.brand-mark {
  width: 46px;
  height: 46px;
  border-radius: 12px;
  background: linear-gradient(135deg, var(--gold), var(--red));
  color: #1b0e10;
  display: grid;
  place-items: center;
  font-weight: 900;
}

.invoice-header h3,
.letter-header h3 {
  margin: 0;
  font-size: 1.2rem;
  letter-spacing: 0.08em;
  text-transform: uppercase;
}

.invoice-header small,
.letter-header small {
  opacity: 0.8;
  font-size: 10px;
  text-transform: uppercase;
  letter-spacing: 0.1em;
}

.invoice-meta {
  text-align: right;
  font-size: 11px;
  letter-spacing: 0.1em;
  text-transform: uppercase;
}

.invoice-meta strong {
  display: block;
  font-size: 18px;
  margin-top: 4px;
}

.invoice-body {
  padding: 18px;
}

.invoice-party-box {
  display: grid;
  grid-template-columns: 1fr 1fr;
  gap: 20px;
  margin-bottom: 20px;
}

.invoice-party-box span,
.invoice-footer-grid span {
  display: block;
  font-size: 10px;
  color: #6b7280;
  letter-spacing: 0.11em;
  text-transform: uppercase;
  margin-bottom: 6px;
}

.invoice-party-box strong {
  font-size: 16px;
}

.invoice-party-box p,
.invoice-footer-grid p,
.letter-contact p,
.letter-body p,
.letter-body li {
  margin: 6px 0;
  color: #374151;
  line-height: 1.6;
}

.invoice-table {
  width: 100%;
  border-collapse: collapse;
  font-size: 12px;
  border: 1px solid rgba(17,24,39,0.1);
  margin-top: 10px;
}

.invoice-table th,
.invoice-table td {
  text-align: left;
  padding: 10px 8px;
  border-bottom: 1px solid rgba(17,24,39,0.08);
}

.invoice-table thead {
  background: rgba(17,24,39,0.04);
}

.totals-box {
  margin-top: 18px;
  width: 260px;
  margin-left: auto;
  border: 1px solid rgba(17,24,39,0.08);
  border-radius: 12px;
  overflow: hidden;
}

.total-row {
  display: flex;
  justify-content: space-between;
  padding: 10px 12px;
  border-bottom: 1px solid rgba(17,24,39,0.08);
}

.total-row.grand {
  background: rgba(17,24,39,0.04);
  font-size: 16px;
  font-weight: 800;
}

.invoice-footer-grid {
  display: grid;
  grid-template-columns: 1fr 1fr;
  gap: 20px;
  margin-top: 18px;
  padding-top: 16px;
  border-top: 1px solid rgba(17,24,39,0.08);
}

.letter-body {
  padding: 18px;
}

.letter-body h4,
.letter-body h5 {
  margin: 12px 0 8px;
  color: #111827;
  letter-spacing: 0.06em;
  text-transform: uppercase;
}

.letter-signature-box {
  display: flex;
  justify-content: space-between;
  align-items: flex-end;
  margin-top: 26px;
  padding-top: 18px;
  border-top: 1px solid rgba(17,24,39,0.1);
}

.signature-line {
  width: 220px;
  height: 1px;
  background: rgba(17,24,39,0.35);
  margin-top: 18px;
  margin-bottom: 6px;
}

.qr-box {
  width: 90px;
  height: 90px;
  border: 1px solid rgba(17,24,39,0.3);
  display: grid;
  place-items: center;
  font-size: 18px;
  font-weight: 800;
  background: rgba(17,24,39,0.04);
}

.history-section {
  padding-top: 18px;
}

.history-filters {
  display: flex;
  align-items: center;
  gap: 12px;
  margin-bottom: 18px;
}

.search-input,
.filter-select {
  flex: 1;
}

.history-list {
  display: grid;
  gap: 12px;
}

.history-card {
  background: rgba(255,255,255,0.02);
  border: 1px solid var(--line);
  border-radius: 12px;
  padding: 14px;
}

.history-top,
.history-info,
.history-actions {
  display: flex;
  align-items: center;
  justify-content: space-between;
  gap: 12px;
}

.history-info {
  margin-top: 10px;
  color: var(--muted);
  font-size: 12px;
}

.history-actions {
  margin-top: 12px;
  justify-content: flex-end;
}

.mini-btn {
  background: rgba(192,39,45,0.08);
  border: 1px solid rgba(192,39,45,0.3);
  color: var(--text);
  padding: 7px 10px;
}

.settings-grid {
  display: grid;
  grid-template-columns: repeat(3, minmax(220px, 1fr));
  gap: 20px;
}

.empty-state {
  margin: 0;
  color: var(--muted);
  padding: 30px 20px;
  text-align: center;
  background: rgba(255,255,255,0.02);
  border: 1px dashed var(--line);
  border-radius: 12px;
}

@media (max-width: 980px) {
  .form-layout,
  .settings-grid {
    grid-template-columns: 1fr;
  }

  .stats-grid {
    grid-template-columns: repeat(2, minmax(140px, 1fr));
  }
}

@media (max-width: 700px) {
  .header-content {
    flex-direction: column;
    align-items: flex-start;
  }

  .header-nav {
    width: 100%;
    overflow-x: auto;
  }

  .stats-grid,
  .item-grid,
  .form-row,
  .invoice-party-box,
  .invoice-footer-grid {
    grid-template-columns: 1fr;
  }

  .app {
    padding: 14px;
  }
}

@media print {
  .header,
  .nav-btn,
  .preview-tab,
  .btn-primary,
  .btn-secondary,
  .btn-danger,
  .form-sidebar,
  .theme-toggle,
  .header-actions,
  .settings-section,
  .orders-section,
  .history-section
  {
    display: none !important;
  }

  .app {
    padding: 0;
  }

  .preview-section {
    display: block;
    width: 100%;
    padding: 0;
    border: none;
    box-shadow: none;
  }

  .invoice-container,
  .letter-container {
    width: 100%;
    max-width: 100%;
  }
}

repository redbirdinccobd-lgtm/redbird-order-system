const STORAGE_KEY = 'rbi_order_system_v1';

const defaultSettings = {
  companyName: 'Red Bird International',
  companyAddress: 'Plot-100, Majar Chow Road, Uttarkhan\nDhaka 1230, Bangladesh',
  phone: '+880 1966-635-888',
  email: 'info@redbird-international.com',
  website: 'www.redbird-international.com'
};

const emptyItem = () => ({
  id: Date.now() + Math.random(),
  name: 'Heavyweight T-Shirt',
  style: 'RBI-TS-240',
  color: 'Navy',
  size: 'M',
  qty: 1000,
  unitPrice: 2.8,
  total: 2800,
  grade: 'A',
  description: '240 GSM heavyweight cotton jersey, export-ready stock.'
});

let state = {
  orders: [],
  settings: { ...defaultSettings }
};

function getDefaultState() {
  return {
    orders: [],
    settings: { ...defaultSettings }
  };
}

function loadState() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) {
      state = getDefaultState();
      return;
    }
    const parsed = JSON.parse(raw);
    state = {
      ...getDefaultState(),
      ...parsed,
      settings: {
        ...defaultSettings,
        ...(parsed.settings || {})
      }
    };
  } catch (err) {
    state = getDefaultState();
  }
}

function saveState() {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
}

function formatMoney(value) {
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
  }).format(Number(value || 0));
}

function generateOrderId() {
  return 'RBI-' + new Date().toISOString().slice(0, 10).replace(/-/g, '') + '-' + Math.floor(Math.random() * 900 + 100);
}

function addItemCard(item = emptyItem()) {
  const wrapper = document.createElement('div');
  wrapper.className = 'item-card';
  wrapper.dataset.id = item.id;

  wrapper.innerHTML = `
    <div class="item-header">
      <strong>Item</strong>
      <button type="button" class="remove-item">Remove</button>
    </div>
    <div class="item-grid">
      <div class="form-group small">
        <label>Item Name</label>
        <input type="text" class="item-name" value="${item.name || ''}" />
      </div>
      <div class="form-group small">
        <label>Style No</label>
        <input type="text" class="item-style" value="${item.style || ''}" />
      </div>
      <div class="form-group small">
        <label>Color</label>
        <input type="text" class="item-color" value="${item.color || ''}" />
      </div>
      <div class="form-group small">
        <label>Size</label>
        <input type="text" class="item-size" value="${item.size || ''}" />
      </div>
      <div class="form-group small">
        <label>Qty</label>
        <input type="number" class="item-qty" min="0" value="${item.qty || 0}" />
      </div>
      <div class="form-group small">
        <label>Unit Price</label>
        <input type="number" class="item-price" step="0.01" min="0" value="${item.unitPrice || 0}" />
      </div>
      <div class="form-group small">
        <label>Grade</label>
        <select class="item-grade">
          <option value="A" ${item.grade === 'A' ? 'selected' : ''}>A</option>
          <option value="B" ${item.grade === 'B' ? 'selected' : ''}>B</option>
          <option value="C" ${item.grade === 'C' ? 'selected' : ''}>C</option>
        </select>
      </div>
      <div class="form-group small">
        <label>Total</label>
        <input type="text" class="item-total" value="${item.total || 0}" readonly />
      </div>
    </div>
    <div class="form-group small textarea-group">
      <label>Product Description</label>
      <textarea rows="2" class="item-description">${item.description || ''}</textarea>
    </div>
  `;

  wrapper.querySelector('.remove-item').addEventListener('click', () => {
    wrapper.remove();
  });

  wrapper.querySelectorAll('input, select, textarea').forEach((field) => {
    field.addEventListener('input', recalcCardTotals);
    field.addEventListener('change', recalcCardTotals);
  });

  recalcCardTotals({ target: wrapper });
  return wrapper;
}

function recalcCardTotals(event) {
  const card = event.target.closest('.item-card') || event.target;
  if (!card) return;

  const qty = Number(card.querySelector('.item-qty')?.value || 0);
  const unitPrice = Number(card.querySelector('.item-price')?.value || 0);
  const total = qty * unitPrice;

  const totalField = card.querySelector('.item-total');
  if (totalField) totalField.value = total.toFixed(2);
}

function getCurrentItems() {
  return [...document.querySelectorAll('.item-card')].map((card) => {
    const qty = Number(card.querySelector('.item-qty').value || 0);
    const unitPrice = Number(card.querySelector('.item-price').value || 0);
    const total = qty * unitPrice;

    return {
      id: card.dataset.id,
      name: card.querySelector('.item-name').value.trim(),
      style: card.querySelector('.item-style').value.trim(),
      color: card.querySelector('.item-color').value.trim(),
      size: card.querySelector('.item-size').value.trim(),
      qty,
      unitPrice,
      total,
      grade: card.querySelector('.item-grade').value,
      description: card.querySelector('.item-description').value.trim()
    };
  }).filter(item => item.name || item.style || item.description || item.qty > 0);
}

function switchTab(tabName) {
  document.querySelectorAll('.nav-btn').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.tab === tabName);
  });

  document.querySelectorAll('.tab-content').forEach(tab => {
    tab.classList.toggle('active', tab.id === `tab-${tabName}`);
  });
}

function renderDashboard() {
  const totalOrders = state.orders.length;
  const totalRevenue = state.orders.reduce((sum, order) => sum + Number(order.total || 0), 0);
  const totalPieces = state.orders.reduce((sum, order) => sum + Number(order.totalPieces || 0), 0);
  const activeShipments = state.orders.filter(order => order.status === 'invoiced' || order.status === 'shipped').length;

  document.getElementById('totalOrders').textContent = totalOrders;
  document.getElementById('totalRevenue').textContent = formatMoney(totalRevenue);
  document.getElementById('totalPieces').textContent = totalPieces.toLocaleString();
  document.getElementById('activeShipments').textContent = activeShipments;

  const ordersList = document.getElementById('ordersList');
  if (!state.orders.length) {
    ordersList.innerHTML = '<p class="empty-state">No orders yet. Create your first shipment to get started.</p>';
    return;
  }

  ordersList.innerHTML = state.orders.slice().reverse().map(order => `
    <div class="order-row">
      <div>
        <strong>${order.companyName}</strong>
        <small>${order.tracking}</small>
      </div>
      <div>
        <span>${order.status}</span>
      </div>
      <div>
        <strong>${formatMoney(order.total || 0)}</strong>
      </div>
    </div>
  `).join('');
}

function renderHistory() {
  const historyList = document.getElementById('historyList');
  const searchValue = document.getElementById('searchHistory').value.toLowerCase();
  const filterStatus = document.getElementById('filterStatus').value;

  const filtered = state.orders.filter(order => {
    const matchesSearch = !searchValue ||
      order.companyName.toLowerCase().includes(searchValue) ||
      order.tracking.toLowerCase().includes(searchValue) ||
      order.items.some(item => item.name.toLowerCase().includes(searchValue));

    const matchesStatus = filterStatus === 'all' || order.status === filterStatus;
    return matchesSearch && matchesStatus;
  });

  if (!filtered.length) {
    historyList.innerHTML = '<p class="empty-state">No order history yet.</p>';
    return;
  }

  historyList.innerHTML = filtered.slice().reverse().map(order => `
    <div class="history-card">
      <div class="history-top">
        <div>
          <strong>${order.companyName}</strong>
          <small>${order.tracking}</small>
        </div>
        <span class="status-tag">${order.status}</span>
      </div>
      <div class="history-info">
        <span>Shipment: ${order.shipmentDate}</span>
        <span>Pieces: ${order.totalPieces}</span>
        <span>Total: ${formatMoney(order.total)}</span>
      </div>
      <div class="history-actions">
        <button class="mini-btn" data-order-id="${order.id}">View</button>
      </div>
    </div>
  `).join('');

  document.querySelectorAll('.mini-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.orderId;
      const order = state.orders.find(item => item.id === id);
      if (!order) return;
      fillFormFromOrder(order);
      switchTab('shipment');
    });
  });
}

function fillFormFromOrder(order) {
  document.getElementById('companyName').value = order.companyName || '';
  document.getElementById('contactPerson').value = order.contactPerson || '';
  document.getElementById('country').value = order.country || '';
  document.getElementById('address').value = order.address || '';
  document.getElementById('email').value = order.email || '';
  document.getElementById('phone').value = order.phone || '';
  document.getElementById('tracking').value = order.tracking || '';
  document.getElementById('shipmentDate').value = order.shipmentDate || '';
  document.getElementById('incoterm').value = order.incoterm || 'CIF';
  document.getElementById('port').value = order.port || '';
  document.getElementById('notes').value = order.notes || '';

  const itemsList = document.getElementById('itemsList');
  itemsList.innerHTML = '';
  order.items.forEach(item => itemsList.appendChild(addItemCard(item)));
}

function getFormData() {
  const items = getCurrentItems();
  const subtotal = items.reduce((sum, item) => sum + Number(item.total || 0), 0);
  const shipping = subtotal * 0.02;
  const total = subtotal + shipping;
  const totalPieces = items.reduce((sum, item) => sum + Number(item.qty || 0), 0);

  return {
    id: generateOrderId(),
    companyName: document.getElementById('companyName').value.trim(),
    contactPerson: document.getElementById('contactPerson').value.trim(),
    country: document.getElementById('country').value.trim(),
    address: document.getElementById('address').value.trim(),
    email: document.getElementById('email').value.trim(),
    phone: document.getElementById('phone').value.trim(),
    tracking: document.getElementById('tracking').value.trim(),
    shipmentDate: document.getElementById('shipmentDate').value,
    incoterm: document.getElementById('incoterm').value,
    port: document.getElementById('port').value.trim(),
    notes: document.getElementById('notes').value.trim(),
    items,
    subtotal,
    shipping,
    total,
    totalPieces,
    status: 'invoiced'
  };
}

