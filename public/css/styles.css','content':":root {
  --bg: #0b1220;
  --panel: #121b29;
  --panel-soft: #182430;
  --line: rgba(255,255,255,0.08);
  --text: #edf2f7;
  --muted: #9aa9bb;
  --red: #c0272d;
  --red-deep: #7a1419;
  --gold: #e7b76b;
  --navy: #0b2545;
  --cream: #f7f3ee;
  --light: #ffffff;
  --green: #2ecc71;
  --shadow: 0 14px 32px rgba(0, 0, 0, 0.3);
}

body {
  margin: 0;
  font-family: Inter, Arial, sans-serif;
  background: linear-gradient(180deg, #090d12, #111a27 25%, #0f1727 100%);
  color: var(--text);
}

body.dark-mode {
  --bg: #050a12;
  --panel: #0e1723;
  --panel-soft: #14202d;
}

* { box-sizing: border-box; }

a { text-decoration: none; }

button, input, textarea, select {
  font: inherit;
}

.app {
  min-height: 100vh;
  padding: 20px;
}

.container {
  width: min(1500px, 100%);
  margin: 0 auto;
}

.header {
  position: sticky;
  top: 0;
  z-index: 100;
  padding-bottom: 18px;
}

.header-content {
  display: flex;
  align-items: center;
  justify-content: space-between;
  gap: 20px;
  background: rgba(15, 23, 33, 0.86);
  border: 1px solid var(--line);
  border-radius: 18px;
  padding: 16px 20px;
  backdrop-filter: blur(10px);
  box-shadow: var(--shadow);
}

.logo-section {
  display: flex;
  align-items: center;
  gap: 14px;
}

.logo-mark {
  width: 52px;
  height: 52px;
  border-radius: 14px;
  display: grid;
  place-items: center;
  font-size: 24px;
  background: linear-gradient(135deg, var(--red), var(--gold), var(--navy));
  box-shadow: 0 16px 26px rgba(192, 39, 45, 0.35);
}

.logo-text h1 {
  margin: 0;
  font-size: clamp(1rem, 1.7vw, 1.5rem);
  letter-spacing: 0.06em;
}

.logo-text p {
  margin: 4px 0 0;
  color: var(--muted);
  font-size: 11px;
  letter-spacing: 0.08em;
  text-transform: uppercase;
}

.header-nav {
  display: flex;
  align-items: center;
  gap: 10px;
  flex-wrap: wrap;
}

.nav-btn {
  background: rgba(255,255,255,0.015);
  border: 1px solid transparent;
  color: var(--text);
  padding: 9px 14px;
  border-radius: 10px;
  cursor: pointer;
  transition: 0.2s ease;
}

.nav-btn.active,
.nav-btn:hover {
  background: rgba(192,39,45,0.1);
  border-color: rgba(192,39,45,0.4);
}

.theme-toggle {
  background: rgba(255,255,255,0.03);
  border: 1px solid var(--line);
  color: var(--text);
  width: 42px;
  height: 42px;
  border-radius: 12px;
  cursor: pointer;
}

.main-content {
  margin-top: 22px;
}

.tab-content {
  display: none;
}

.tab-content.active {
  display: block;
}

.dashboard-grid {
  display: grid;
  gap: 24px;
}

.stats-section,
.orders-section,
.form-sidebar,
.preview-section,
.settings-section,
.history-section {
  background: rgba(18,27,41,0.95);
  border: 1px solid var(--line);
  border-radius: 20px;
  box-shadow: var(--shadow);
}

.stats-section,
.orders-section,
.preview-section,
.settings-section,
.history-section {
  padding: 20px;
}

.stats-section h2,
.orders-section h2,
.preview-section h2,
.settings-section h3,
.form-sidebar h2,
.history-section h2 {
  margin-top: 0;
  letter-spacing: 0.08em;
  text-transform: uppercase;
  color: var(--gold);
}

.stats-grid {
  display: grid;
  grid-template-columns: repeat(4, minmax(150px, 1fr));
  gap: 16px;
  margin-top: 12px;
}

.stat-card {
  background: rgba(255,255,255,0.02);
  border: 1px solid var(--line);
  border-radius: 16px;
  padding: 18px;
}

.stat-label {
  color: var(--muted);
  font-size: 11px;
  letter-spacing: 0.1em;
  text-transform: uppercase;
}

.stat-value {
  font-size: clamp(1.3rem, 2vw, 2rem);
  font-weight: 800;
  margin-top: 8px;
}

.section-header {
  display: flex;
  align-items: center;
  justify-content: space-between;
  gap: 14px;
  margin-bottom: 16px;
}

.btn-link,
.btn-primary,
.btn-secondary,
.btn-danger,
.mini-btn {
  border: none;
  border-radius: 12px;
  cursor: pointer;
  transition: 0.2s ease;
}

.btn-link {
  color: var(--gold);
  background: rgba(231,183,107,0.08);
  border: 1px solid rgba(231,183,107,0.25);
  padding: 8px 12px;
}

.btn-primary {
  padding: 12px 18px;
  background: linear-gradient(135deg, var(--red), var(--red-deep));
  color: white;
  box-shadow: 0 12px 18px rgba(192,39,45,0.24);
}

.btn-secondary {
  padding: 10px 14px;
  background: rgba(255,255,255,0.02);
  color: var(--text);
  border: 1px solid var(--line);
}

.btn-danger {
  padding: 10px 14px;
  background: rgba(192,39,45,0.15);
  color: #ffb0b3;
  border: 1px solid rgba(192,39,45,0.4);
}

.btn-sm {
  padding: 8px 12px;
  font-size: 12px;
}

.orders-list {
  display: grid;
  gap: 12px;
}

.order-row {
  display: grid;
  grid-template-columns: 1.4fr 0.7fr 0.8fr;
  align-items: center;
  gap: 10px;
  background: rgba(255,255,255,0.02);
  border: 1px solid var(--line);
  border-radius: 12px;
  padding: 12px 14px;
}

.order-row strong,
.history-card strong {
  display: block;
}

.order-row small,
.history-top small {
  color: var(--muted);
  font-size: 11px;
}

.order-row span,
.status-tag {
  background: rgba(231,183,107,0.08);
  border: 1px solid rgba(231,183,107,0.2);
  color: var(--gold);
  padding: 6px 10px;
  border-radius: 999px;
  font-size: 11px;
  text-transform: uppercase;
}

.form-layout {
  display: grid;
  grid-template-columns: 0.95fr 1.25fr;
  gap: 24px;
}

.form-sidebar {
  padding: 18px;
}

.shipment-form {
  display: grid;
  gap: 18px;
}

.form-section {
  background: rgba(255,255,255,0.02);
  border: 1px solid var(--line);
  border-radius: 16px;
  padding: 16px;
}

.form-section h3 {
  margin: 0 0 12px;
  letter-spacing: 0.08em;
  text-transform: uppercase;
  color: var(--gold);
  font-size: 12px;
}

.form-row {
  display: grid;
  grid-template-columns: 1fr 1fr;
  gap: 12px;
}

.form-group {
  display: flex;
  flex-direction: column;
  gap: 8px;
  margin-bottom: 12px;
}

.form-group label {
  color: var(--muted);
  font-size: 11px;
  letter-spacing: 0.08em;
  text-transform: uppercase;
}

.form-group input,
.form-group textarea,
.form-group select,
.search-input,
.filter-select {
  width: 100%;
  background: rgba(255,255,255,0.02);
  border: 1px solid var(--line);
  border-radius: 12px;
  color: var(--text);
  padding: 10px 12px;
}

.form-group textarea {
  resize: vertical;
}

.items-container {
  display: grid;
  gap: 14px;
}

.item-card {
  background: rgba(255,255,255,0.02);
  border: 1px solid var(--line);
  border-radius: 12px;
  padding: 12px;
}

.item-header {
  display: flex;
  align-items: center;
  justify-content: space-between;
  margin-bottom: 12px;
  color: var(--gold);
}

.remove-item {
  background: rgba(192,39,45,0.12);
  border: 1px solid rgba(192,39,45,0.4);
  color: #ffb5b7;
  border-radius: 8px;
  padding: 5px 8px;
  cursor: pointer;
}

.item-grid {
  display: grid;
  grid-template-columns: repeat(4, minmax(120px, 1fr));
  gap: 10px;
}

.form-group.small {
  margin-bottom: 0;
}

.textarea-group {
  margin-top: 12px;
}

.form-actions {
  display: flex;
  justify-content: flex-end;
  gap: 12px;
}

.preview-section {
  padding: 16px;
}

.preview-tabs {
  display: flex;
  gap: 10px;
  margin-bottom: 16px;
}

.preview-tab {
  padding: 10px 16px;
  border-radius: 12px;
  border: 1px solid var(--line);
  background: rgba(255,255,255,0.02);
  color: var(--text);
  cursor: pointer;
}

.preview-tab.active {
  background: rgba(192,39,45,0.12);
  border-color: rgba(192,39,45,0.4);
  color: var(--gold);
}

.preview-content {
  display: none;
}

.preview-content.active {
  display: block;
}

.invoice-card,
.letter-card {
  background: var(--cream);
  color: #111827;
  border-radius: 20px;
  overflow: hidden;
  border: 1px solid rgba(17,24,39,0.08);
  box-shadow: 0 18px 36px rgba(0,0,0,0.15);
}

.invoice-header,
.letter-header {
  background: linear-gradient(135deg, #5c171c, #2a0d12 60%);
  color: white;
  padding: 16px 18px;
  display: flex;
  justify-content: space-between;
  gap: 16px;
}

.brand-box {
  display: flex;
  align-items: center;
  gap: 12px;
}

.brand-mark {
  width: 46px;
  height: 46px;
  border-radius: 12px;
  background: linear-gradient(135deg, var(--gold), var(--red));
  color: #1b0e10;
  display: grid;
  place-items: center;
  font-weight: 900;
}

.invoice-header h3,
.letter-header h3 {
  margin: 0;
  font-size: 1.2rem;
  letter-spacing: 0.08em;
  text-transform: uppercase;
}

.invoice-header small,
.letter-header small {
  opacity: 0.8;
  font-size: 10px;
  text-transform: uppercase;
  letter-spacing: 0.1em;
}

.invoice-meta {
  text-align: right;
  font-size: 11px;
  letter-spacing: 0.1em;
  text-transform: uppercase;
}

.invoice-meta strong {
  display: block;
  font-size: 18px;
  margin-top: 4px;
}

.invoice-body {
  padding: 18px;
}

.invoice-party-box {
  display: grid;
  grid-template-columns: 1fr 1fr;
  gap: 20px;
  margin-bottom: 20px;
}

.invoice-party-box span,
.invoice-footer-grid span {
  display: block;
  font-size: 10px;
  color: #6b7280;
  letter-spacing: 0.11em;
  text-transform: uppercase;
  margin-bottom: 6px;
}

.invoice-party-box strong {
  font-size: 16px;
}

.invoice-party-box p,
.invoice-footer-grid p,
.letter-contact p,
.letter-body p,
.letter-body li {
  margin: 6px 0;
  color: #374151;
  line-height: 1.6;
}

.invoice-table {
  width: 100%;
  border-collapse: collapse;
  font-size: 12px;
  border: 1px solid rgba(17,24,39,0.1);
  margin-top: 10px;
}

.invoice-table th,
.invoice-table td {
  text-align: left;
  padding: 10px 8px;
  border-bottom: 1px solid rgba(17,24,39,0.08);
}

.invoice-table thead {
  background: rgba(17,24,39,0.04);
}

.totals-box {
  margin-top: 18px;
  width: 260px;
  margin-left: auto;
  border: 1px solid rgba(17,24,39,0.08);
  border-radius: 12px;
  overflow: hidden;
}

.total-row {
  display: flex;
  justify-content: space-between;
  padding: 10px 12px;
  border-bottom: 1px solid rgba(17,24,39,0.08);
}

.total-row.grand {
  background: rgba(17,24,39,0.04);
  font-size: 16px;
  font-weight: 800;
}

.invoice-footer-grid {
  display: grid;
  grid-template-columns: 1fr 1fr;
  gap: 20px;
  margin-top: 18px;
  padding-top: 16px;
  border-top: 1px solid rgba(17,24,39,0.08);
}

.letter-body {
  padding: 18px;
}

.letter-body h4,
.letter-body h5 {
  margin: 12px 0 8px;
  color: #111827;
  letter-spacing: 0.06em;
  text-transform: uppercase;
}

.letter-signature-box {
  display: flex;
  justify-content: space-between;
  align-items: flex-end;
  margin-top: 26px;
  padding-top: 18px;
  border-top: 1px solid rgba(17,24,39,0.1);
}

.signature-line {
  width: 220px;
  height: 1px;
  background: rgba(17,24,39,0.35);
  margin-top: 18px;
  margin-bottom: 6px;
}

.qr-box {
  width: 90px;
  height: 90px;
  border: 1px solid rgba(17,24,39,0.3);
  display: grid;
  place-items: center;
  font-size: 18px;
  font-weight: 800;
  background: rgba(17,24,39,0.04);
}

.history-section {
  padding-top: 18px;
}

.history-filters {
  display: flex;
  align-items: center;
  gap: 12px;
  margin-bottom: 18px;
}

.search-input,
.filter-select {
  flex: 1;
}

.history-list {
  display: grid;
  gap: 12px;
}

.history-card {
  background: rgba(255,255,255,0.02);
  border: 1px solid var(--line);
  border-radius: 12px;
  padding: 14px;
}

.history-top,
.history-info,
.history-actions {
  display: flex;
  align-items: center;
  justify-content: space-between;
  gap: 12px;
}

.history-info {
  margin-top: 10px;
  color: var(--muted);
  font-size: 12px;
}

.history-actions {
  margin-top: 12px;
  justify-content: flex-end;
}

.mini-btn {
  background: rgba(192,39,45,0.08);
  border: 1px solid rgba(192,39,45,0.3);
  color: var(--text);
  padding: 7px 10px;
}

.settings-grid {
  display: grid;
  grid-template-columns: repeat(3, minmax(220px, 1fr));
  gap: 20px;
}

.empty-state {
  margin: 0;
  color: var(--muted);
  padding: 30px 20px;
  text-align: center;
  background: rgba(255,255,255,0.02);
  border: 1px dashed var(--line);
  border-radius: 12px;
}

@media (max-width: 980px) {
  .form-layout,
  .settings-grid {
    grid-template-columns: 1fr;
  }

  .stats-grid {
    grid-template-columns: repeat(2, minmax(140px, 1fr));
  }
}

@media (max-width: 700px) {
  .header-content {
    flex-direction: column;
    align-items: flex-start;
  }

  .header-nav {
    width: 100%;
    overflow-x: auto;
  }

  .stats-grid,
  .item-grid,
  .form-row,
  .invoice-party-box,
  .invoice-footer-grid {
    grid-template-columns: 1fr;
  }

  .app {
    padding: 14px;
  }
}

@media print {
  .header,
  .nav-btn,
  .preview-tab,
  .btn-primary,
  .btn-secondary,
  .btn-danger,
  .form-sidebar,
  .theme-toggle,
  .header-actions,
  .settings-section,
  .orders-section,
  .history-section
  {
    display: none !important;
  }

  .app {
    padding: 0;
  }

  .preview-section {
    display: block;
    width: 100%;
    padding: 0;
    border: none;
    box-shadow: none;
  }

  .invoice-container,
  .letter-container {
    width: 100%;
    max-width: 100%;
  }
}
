function generateCurrentOrder() {
  const formData = getFormData();
  if (!formData.companyName || !formData.address || !formData.tracking || !formData.shipmentDate || !formData.items.length) {
    alert('Please fill in the required buyer information and at least one product item.');
    return;
  }

  renderInvoice(formData);
  renderLetter(formData);

  state.orders.push(formData);
  saveState();
  renderDashboard();
  renderHistory();
}

function resetForm() {
  document.getElementById('shipmentForm').reset();
  const itemsList = document.getElementById('itemsList');
  itemsList.innerHTML = '';
  itemsList.appendChild(addItemCard(emptyItem()));
  document.getElementById('shipmentDate').valueAsDate = new Date();
}

function initializeDefaultItems() {
  const itemsList = document.getElementById('itemsList');
  itemsList.innerHTML = '';
  const defaultItem = emptyItem();
  itemsList.appendChild(addItemCard(defaultItem));
}

function bindEvents() {
  document.querySelectorAll('.nav-btn').forEach(btn => {
    btn.addEventListener('click', () => switchTab(btn.dataset.tab));
  });

  document.getElementById('addItemBtn').addEventListener('click', () => {
    document.getElementById('itemsList').appendChild(addItemCard(emptyItem()));
  });

  document.getElementById('generateBtn').addEventListener('click', generateCurrentOrder);
  document.getElementById('resetBtn').addEventListener('click', resetForm);
  document.getElementById('printInvoiceBtn').addEventListener('click', () => window.print());
  document.getElementById('printLetterBtn').addEventListener('click', () => window.print());

  document.getElementById('themeToggle').addEventListener('click', () => {
    document.body.classList.toggle('dark-mode');
  });

  document.querySelectorAll('.preview-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.preview-tab').forEach(btn => btn.classList.toggle('active', btn === tab));
      document.querySelectorAll('.preview-content').forEach(panel => {
        panel.classList.toggle('active', panel.id === `preview-${tab.dataset.preview}`);
      });
    });
  });

  document.getElementById('searchHistory').addEventListener('input', renderHistory);
  document.getElementById('filterStatus').addEventListener('change', renderHistory);

  document.getElementById('saveSettingsBtn').addEventListener('click', () => {
    state.settings.companyName = document.getElementById('settingsCompanyName').value.trim();
    state.settings.companyAddress = document.getElementById('settingsAddress').value.trim();
    state.settings.phone = document.getElementById('settingsPhone').value.trim();
    state.settings.email = document.getElementById('settingsEmail').value.trim();
    state.settings.website = document.getElementById('settingsWebsite').value.trim();
    saveState();
    renderDashboard();
    alert('Settings saved successfully.');
  });

  document.getElementById('exportDataBtn').addEventListener('click', () => {
    const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'redbird-order-data.json';
    a.click();
    URL.revokeObjectURL(url);
  });

  document.getElementById('clearDataBtn').addEventListener('click', () => {
    if (!confirm('This will clear all saved data. Continue?')) return;
    state = getDefaultState();
    saveState();
    renderDashboard();
    renderHistory();
    resetForm();
  });

  document.getElementById('importDataBtn').addEventListener('click', () => {
    document.getElementById('importFile').click();
  });

  document.getElementById('importFile').addEventListener('change', (event) => {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      try {
        const parsed = JSON.parse(reader.result);
        state = {
          ...getDefaultState(),
          ...parsed,
          settings: {
            ...defaultSettings,
            ...(parsed.settings || {})
          }
        };
        saveState();
        renderDashboard();
        renderHistory();
        alert('Data imported successfully.');
      } catch (err) {
        alert('Invalid JSON file.');
      }
    };
    reader.readAsText(file);
  });
}

function init() {
  loadState();
  initializeDefaultItems();
  bindEvents();
  document.getElementById('shipmentDate').valueAsDate = new Date();
  renderDashboard();
  renderHistory();
  generateCurrentOrder();
}

window.addEventListener('DOMContentLoaded', init);

window.addEventListener('beforeunload', () => {
  saveState();
});
